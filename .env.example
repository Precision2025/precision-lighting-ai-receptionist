# Required
OPENAI_API_KEY=replace_me
PUBLIC_BASE_URL=https://your-app.onrender.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me

# The number Faith transfers urgent callers to.
# Default shown is Precision Lighting's local number.
LIVE_TRANSFER_NUMBER=+12142435649

# OpenAI model. Change without editing code.
OPENAI_MODEL=gpt-4.1-mini

# Voice options supported by Twilio ConversationRelay
TTS_PROVIDER=Google
TTS_VOICE=en-US-Journey-O
TRANSCRIPTION_PROVIDER=Deepgram
SPEECH_MODEL=nova-3-general

# Optional email call summaries
SUMMARY_EMAIL_TO=Dispatch@theprecisionlighting.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=Dispatch@theprecisionlighting.com
SMTP_PASS=replace_with_app_password
SUMMARY_EMAIL_FROM=Dispatch@theprecisionlighting.com

# Optional SMS call summaries. Requires a Twilio SMS-capable number.
SUMMARY_SMS_TO=
TWILIO_SMS_FROM=

# Security
# Keep true in production. Set false only for local testing through an unusual proxy.
VALIDATE_TWILIO_SIGNATURE=true

PORT=3000

# O'Reilly / ServiceChannel IVR by text
# Joshua calls the saved Service Channel Check In number.
SERVICECHANNEL_IVR_NUMBER=+15165007776
SERVICECHANNEL_PIN=replace_with_servicechannel_pin
# Must be a Twilio voice-capable number owned by your account.
SERVICECHANNEL_VOICE_FROM=+1XXXXXXXXXX
# Comma-separated numbers allowed to command Joshua. Travis/Ariana/Shellie
# transfer numbers are also automatically recognized when configured above.
SERVICECHANNEL_AUTHORIZED_NUMBERS=+12142435649,+19729044736,+19729044735
# Optional separate mobile numbers if different from transfer numbers.
ARIANA_SMS_NUMBER=
SHELLIE_SMS_NUMBER=
# IVR timing. Each w is a 0.5-second pause.
SERVICECHANNEL_LANGUAGE_PAUSE=wwww
SERVICECHANNEL_PIN_PAUSE=wwwwww
SERVICECHANNEL_TRACKING_PAUSE=wwwwww
SERVICECHANNEL_STATUS_PAUSE=wwww
SERVICECHANNEL_TECH_PAUSE=wwww

CLOCKSHARK_TECHNICIANS_WEBHOOK_URL=

WISHLIST_TEXT_TO=+12142435649
